[Unit]
Description=Chukonu patent/OpenAlex API on port 9001
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/chuonu-search-solution/patent_search_engine
Environment=HOME=/home/ec2-user
ExecStart=/home/ec2-user/chuonu-search-solution/patent_search_engine/.venv/bin/python run_server.py
Restart=on-failure
RestartSec=2
StandardOutput=append:/home/ec2-user/chuonu-search-solution/patent_search_engine/.local_data/logs/api-9001.log
StandardError=append:/home/ec2-user/chuonu-search-solution/patent_search_engine/.local_data/logs/api-9001.log

[Install]
WantedBy=multi-user.target
