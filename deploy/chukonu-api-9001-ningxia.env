# The target Elasticsearch cluster has security disabled and is local-only.
ES_HOST=127.0.0.1
ES_PORT=9200
ES_CN_ABSTRACT_INDEX_NAME=patents
ES_EPO_DOCDB_INDEX_NAME=epo_docdb
ES_GOOGLE_PATENTS_INDEX_NAME=google_patents
ES_OPENALEX_INDEX_NAME=openalex_read
ES_OPENALEX_PDF_DOC_INDEX_NAME=openalex_pdf_doc
ES_OPENALEX_PDF_CHUNK_INDEX_NAME=openalex_pdf_chunk
ENABLE_MILVUS=false
API_HOST=127.0.0.1
API_PORT=9001
API_WORKERS=1
API_MAX_INFLIGHT=128
API_RETRY_AFTER=1
DATA_CSV_PATH=./.local_data/patent_data.csv
PROGRESS_FILE=./.local_data/indexing_progress.json
LOG_DIR=./.local_data/logs
