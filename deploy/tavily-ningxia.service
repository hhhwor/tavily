[Unit]
Description=Tavily search MCP service on Ningxia host
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/tavily
EnvironmentFile=/etc/tavily/tavily.env
Environment=PYTHONUNBUFFERED=1
Environment=STATE_DB_PATH=/var/lib/tavily/chukonu-state.sqlite3
Environment=OPENALEX_API_URL=http://127.0.0.1:9001
Environment=DOUBAO_UVX_PATH=/home/ec2-user/tavily/deploy/run-doubao-mcp-offline.sh
ExecStart=/home/ec2-user/tavily/.venv311/bin/uvicorn src.api:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
