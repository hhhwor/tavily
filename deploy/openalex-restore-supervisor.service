[Unit]
Description=Restore and verify migrated OpenAlex snapshot on Ningxia Elasticsearch
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/sbin/run-openalex-restore-supervisor
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
